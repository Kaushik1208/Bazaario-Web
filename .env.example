# --- Database ---
# This project ships configured for SQLite by default — zero setup, no server
# to run. Just leave this as-is and everything works out of the box.
DATABASE_URL="file:./dev.db"
# For a real deployment, switch prisma/schema.prisma's datasource provider back
# to "postgresql" and point this at your Postgres instance instead.

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"

# --- OpenAI (optional) ---
# If unset, the AI engine automatically falls back to a deterministic rule-based
# recommendation engine so the full demo still works without an API key.
OPENAI_API_KEY=""

# --- Razorpay Test Mode (optional) ---
# If unset, the payment layer automatically falls back to a mock Razorpay client
# that simulates order creation / success / failure so the full demo still works
# without real Razorpay test keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

NEXT_PUBLIC_RAZORPAY_KEY_ID=""
